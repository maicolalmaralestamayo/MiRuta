APP_NAME=MiRuta
APP_ENV=local
# Clave de cifrado. Generar con: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Havana
APP_LOCALE=es

# Clave para firmar los JWT. Cambiarla cierra todas las sesiones.
# Generar con: php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
JWT_SECRET=

# Clave de mantenimiento (16 caracteres o más) para Mantenimiento del servidor sin sesión.
MAINTENANCE_KEY=

# Sin cron: tareas programadas al terminar las peticiones.
TASKS_ON_REQUESTS=true

# Swagger UI en /docs (solo desarrollo)
DOCS_ENABLED=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=miruta
DB_USERNAME=miruta
DB_PASSWORD=

CACHE_STORE=file
LOG_CHANNEL=stack
