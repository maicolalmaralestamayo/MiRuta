APP_NAME=MiTransporte
APP_ENV=local
# Clave de cifrado (carné). Generar con: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_LOCALE=es

# Clave del HMAC del carné. No cambiarla una vez haya datos.
# Generar con: php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
CARD_HASH_KEY=

# Clave para firmar los JWT. Cambiarla cierra todas las sesiones.
# Generar con: php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
JWT_SECRET=

# Swagger UI en /docs (solo desarrollo)
DOCS_ENABLED=true

LOG_CHANNEL=stack
LOG_SLACK_WEBHOOK_URL=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mitransporte
DB_USERNAME=mitransporte
DB_PASSWORD=

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
