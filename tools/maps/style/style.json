{
  "version": 8,
  "name": "MiRuta sencillo",
  "metadata": { "descripcion": "Solo calles con sus nombres, edificios y PDI (docs/09-repaso-pantallas.md)" },
  "sources": { "openmaptiles": { "type": "vector", "url": "mbtiles://{openmaptiles}" } },
  "glyphs": "{fontstack}/{range}.pbf",
  "layers": [
    { "id": "fondo", "type": "background", "paint": { "background-color": "#f6f4ef" } },
    { "id": "agua", "type": "fill", "source": "openmaptiles", "source-layer": "water", "paint": { "fill-color": "#cfe2f3" } },
    { "id": "edificios", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 14,
      "paint": { "fill-color": "#e2ddd3", "fill-outline-color": "#cfc8bb" } },
    { "id": "calles-borde", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#c9c4ba", "line-width": { "base": 1.4, "stops": [[10, 1], [14, 5], [17, 14]] } } },
    { "id": "calles", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#ffffff", "line-width": { "base": 1.4, "stops": [[10, 0.5], [14, 3.5], [17, 11]] } } },
    { "id": "vias-principales", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk", "primary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#ffd58a", "line-width": { "base": 1.4, "stops": [[7, 1], [14, 5], [17, 14]] } } },
    { "id": "nombres-calles", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name", "minzoom": 13,
      "layout": { "symbol-placement": "line", "text-field": "{name}", "text-font": ["Noto Sans Regular"], "text-size": 12 },
      "paint": { "text-color": "#333333", "text-halo-color": "#ffffff", "text-halo-width": 1.5 } },
    { "id": "pdi", "type": "symbol", "source": "openmaptiles", "source-layer": "poi", "minzoom": 15,
      "layout": { "text-field": "{name}", "text-font": ["Noto Sans Regular"], "text-size": 11, "text-anchor": "top", "text-offset": [0, 0.4] },
      "paint": { "text-color": "#000080", "text-halo-color": "#ffffff", "text-halo-width": 1.5 } },
    { "id": "lugares", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "maxzoom": 14,
      "filter": ["in", "class", "city", "town", "village"],
      "layout": { "text-field": "{name}", "text-font": ["Noto Sans Bold"], "text-size": { "stops": [[7, 11], [13, 15]] } },
      "paint": { "text-color": "#222222", "text-halo-color": "#ffffff", "text-halo-width": 2 } }
  ]
}
