# MiRuta — configuración del servidor de producción.
# Copiar a .env y completar. Ver INSTALAR.md.

APP_NAME=MiRuta
APP_ENV=production
APP_DEBUG=false
# Dirección pública de la API, p. ej. https://miruta.miempresa.cu o http://203.0.113.10
APP_URL=
APP_TIMEZONE=America/Havana
APP_LOCALE=es

# Clave de cifrado. Generar con: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# NO cambiarla una vez haya datos.
APP_KEY=

# Clave para firmar las sesiones (JWT). Generar con: php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
# Cambiarla cierra todas las sesiones.
JWT_SECRET=

# Documentación Swagger en /docs (dejar en false en producción)
DOCS_ENABLED=false
OPENAPI_PATH=../openapi.yaml

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=miruta
DB_USERNAME=miruta
DB_PASSWORD=

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
